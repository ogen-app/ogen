{{- range $i, $c := .Rubric.Criteria}}{{if $i}}, {{end}}"{{$c.Key}}": {"level": 3{{if eq $c.Hint "phase"}}, "phase": "…"{{else if eq $c.Hint "campaign"}}, "campaign": "…"{{end}}, "why": "…"}{{end}}}, "caps": []}}{{end}}
