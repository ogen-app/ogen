# Ogen local stack configuration — consumed by docker-compose.yml.
# Copy this file and fill in real values (the copy is gitignored):
#   cp .env.example .env

# --- API service ---
ADDR=:9001
DATABASE_DSN=postgres://ogen:ogen@postgres:5432/ogen?sslmode=disable

# Embeddings (CON-101): hosted Gemini Embedding 2. GEMINI_API_KEY is a first-boot
# seed only (CON-104) — it is migrated into the encrypted secret store on startup
# and thereafter set/rotated via PUT /api/secrets/gemini_api_key (like the
# Anthropic/Zernio keys, which is why they aren't listed here). Leave empty to
# start with embedding disabled — asset saves still succeed, but no vectors are
# written and semantic search returns nothing until a key is set. EMBED_DIMENSIONS
# must match the assets_chunks.embedding halfvec(N) column.
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-2
EMBED_DIMENSIONS=3072

# Envelope-encryption KEK directory (mounted from the ogen-keys volume).
OGEN_KEK_PATH=/var/lib/ogen/keys

# Internal operator gRPC surface (secrets management for Harbor). The server
# starts ONLY when both GRPC_ADDR and GRPC_AUTH_TOKEN are set; an empty token
# keeps it off (never run unauthenticated). GRPC_AUTH_TOKEN is a shared bearer
# token — Harbor must send the same value as OGEN_GRPC_TOKEN.
#
# The code default is 127.0.0.1:9091 (loopback-only). Inside a container you
# must bind all interfaces (":9091") for the published port to work — but keep
# that published port on the host loopback only (see docker-compose) and behind
# a firewall/NetworkPolicy in prod. The transport is plaintext, so the token
# must never traverse an untrusted network.
#
# On a multi-service platform (e.g. Railway) Harbor and Ogen are SEPARATE
# services that talk over the provider's private network, which is IPv6-only.
# Bind GRPC_ADDR=:9091 — Go listens on the IPv6 wildcard [::] — and do NOT use
# 127.0.0.1 (loopback, unreachable cross-service) or 0.0.0.0 (IPv4-only, also
# unreachable). Point Harbor's OGEN_GRPC_ADDR at <ogen-service>.railway.internal:9091
# and set its OGEN_GRPC_TOKEN to this exact value, with NO trailing newline/space.
#
# In the local stack, docker-compose defaults GRPC_AUTH_TOKEN to a dev token
# (ogen-harbor-dev) and reuses the SAME value for Harbor's OGEN_GRPC_TOKEN, so
# `docker compose --profile harbor up` links the two out of the box. Set a real
# value here to override both.
GRPC_ADDR=:9091
GRPC_AUTH_TOKEN=

# Object storage (Cloudflare R2 / S3-compatible).
# Leave STORAGE_ENDPOINT empty to disable image/PDF uploads.
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=https://pub-<hash>.r2.dev

# PDF parsing microservice (CON-103). The API streams PDFs to pdf-service over
# gRPC, exclusively on the private network. Leave empty to disable PDF ingestion.
# Compose: pdf-service:50051 — Railway prod: pdf-service.railway.internal:50051.
PDF_SERVICE_ADDR=pdf-service:50051

# Video probing microservice (CON-148). The API hands video-service a presigned
# GET URL over gRPC on the private network; ffprobe returns duration/codec/
# resolution + a poster frame. Leave empty to disable probing (uploads accepted
# but unprobed). Compose: video-service:50051 (behind the `video` profile) —
# Railway prod: video-service.railway.internal:50051.
VIDEO_SERVICE_ADDR=

# Document parsing microservice (CON-280). The API streams office/text documents
# (.docx/.pptx/.xlsx/.odt/... ) to document-service over gRPC on the private
# network and gets back embedding-ready, source-anchored chunks. Leave empty to
# disable document ingestion (those uploads fail fast with a clear message).
# Compose: document-service:50051 (behind the `documents` profile) — Railway
# prod: document-service.railway.internal:50051.
DOCUMENTS_SERVICE_ADDR=

# Zernio post-OAuth redirect target.
ZERNIO_REDIRECT_URL=http://localhost:9001

# Environment label baked into each tenant's Zernio profile name
# ("Ogen-${ZERNIO_ENV}-${TENANT_ID}"), so dev/staging/prod instances sharing one
# Zernio account stay distinguishable on the dashboard. Defaults to "dev".
ZERNIO_ENV=dev

# Usage metering & per-tenant cost limits (CON-86). ANALYTICS_DSN points at the
# isolated analytics (TimescaleDB) database — the bundled `timescaledb` compose
# service. Leave empty to disable usage recording + enforcement entirely (calls
# proceed, nothing recorded). docker-compose defaults the API to this DSN even
# when blank; set it explicitly here to override (e.g. a managed TimescaleDB).
ANALYTICS_DSN=postgres://ogen:ogen@timescaledb:5432/ogen_analytics?sslmode=disable

# Global default spend caps in USD-micros for tenants without an override row
# (0 = no default cap). Mode is enforce (block once over) or warn (count only).
USAGE_DEFAULT_DAILY_CAP_MICROS=0
USAGE_DEFAULT_MONTHLY_CAP_MICROS=0
USAGE_DEFAULT_MODE=enforce

# Operator token for PUT /api/usage/limits (X-Admin-Token header). Raising a cap
# is an operator action, not tenant self-service. EMPTY = the write route is
# disabled (fail-closed); tenant users cannot lift their own limits.
USAGE_ADMIN_TOKEN=

# Optional per-model price override (JSON: vendor -> model -> kind -> USD-micros
# per 1M). Empty uses the in-code defaults. A bad payload / unknown vendor fails
# boot. Example: {"anthropic":{"claude-haiku-4-5-20251001":{"input":1000000}}}
USAGE_MODEL_PRICES=

# --- Postgres service ---
POSTGRES_USER=ogen
POSTGRES_PASSWORD=ogen
POSTGRES_DB=ogen

# --- Harbor companion service (../harbor) ---
# `docker compose --profile harbor up` brings Harbor (Ogen's ops dashboard) up
# alongside this stack and links the two over gRPC (see GRPC_AUTH_TOKEN above).
# Harbor shares this stack's postgres — its own `harbor` database, auto-created
# on first boot. Both halves live-reload: the Go backend (air) on
# http://localhost:9003 and the Next.js UI (Turbopack HMR) on
# http://localhost:9005 — open :9005 for the hot-reloading UI. Point HARBOR_PATH
# at your harbor checkout if it isn't the sibling ../harbor.
HARBOR_PATH=../harbor
