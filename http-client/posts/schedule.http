@baseUrl = http://localhost:9001

# Schedule a Post for publishing — CON-78.
# POST /api/posts/:id/schedule is the shared schedule service behind a thin
# REST endpoint (the same service the Post Assistant's schedulePost tool and
# the PUT scheduling branch use).
#
# All endpoints require authentication. Run "Login" from sessions/sessions.http
# first — the HTTP client stores and replays the cookie automatically.
#
# Prerequisites:
#   - {{campaignId}} set (run campaigns/campaigns.http → createCampaign)
#   - Optional: a workspace timezone (settings/settings.http → "Set the
#     workspace timezone"). Only affects relative-time resolution + the echoed
#     time; the stored scheduled_at is always absolute UTC.
#
# Two-id note (important):
#   - A post's `platform_id` is the platform's Sqid (LinkedIn = AXqWG7U2qnpt,
#     Instagram = rzgpTkARLH0L). These are the real seeded ids post-CON-65.
#   - The auto-publish allowlist (auto-publish-allowlist/…) keys off Zernio's
#     wire id ("linkedin", "instagram", …).
#   Routing: platform Sqid → Zernio id → allowlist lookup → auto (scheduled) or
#   manual (scheduled_for_manual_publishing).
#
# State machine: only ready_for_publish (or a draft scheduled with
# allow_promote) can be scheduled. Reschedule = cancel first, then schedule
# again.

@linkedinPlatformId = AXqWG7U2qnpt
@instagramPlatformId = rzgpTkARLH0L

# scheduled_at must be STRICTLY in the future at commit time. These are fixed
# far-future / past instants so the examples don't expire; adjust as needed.
@futureAt = 2030-06-15T09:00:00Z
@pastAt = 2020-01-01T00:00:00Z

###
# ── Setup (routing) ───────────────────────────────────────────────────────────
###

### Setup A — allowlist LinkedIn so scheduling routes to AUTO-publish  [protected]
PUT {{baseUrl}}/api/auto-publish-allowlist
Content-Type: application/json

{
  "platforms": ["linkedin"]
}

### Setup B — clear the allowlist so scheduling routes to MANUAL publishing  [protected]
PUT {{baseUrl}}/api/auto-publish-allowlist
Content-Type: application/json

{
  "platforms": []
}

###
# ── Helpers: create posts to schedule ─────────────────────────────────────────
###

### Helper — create a ready-to-publish LinkedIn post  [protected]
# @name createReadyPost
# Created directly in ready_for_publish (article requires content; passes the
# CON-74 publish gate at create time). Re-run this before each schedule below
# that needs a fresh, un-scheduled post.
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{linkedinPlatformId}}",
  "platform_post_type": "article",
  "title": "Launch announcement",
  "content": "We're shipping something new next week — here's what to expect.",
  "status": "ready_for_publish",
  "cta_type": "none"
}

> {% client.global.set("scheduleReadyId", response.body.id) %}

### Helper — create a DRAFT LinkedIn post (valid, promotable)  [protected]
# @name createDraft
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{linkedinPlatformId}}",
  "platform_post_type": "article",
  "title": "Draft to promote then schedule",
  "content": "Draft body that already satisfies the publish rules.",
  "status": "draft",
  "cta_type": "none"
}

> {% client.global.set("scheduleDraftId", response.body.id) %}

### Helper — create a DRAFT image-post with NO image (fails validation)  [protected]
# @name createBadDraft
# Instagram image-post requires at least one image attachment; this draft has
# none, so promoting it during a schedule fails CON-74 validation (422).
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{instagramPlatformId}}",
  "platform_post_type": "image-post",
  "title": "Image post with no image",
  "status": "draft",
  "cta_type": "none"
}

> {% client.global.set("scheduleBadDraftId", response.body.id) %}

###
# ── Schedule scenarios ────────────────────────────────────────────────────────
###

### 1. Schedule a ready post — MANUAL  [protected]
# Run Setup B (clear allowlist) + createReadyPost first.
# → 200 { status: "scheduled_for_manual_publishing", auto_publish: false }
POST {{baseUrl}}/api/posts/{{scheduleReadyId}}/schedule
Content-Type: application/json

{
  "scheduled_at": "{{futureAt}}"
}

### 2. Schedule a ready post — AUTO-publish  [protected]
# Run Setup A (allowlist LinkedIn) + createReadyPost (fresh post) first.
# → 200 { status: "scheduled", auto_publish: true }  (enqueues the Zernio submit)
POST {{baseUrl}}/api/posts/{{scheduleReadyId}}/schedule
Content-Type: application/json

{
  "scheduled_at": "{{futureAt}}"
}

### 3. Schedule a DRAFT with allow_promote  [protected]
# Run createDraft first. Runs CON-74 validation, promotes Draft →
# ReadyForPublish, then schedules. → 200 { promoted: true }
POST {{baseUrl}}/api/posts/{{scheduleDraftId}}/schedule
Content-Type: application/json

{
  "scheduled_at": "{{futureAt}}",
  "allow_promote": true
}

### 4. Schedule a DRAFT that fails validation when promoting (expects 422)  [protected]
# Run createBadDraft first. → 422 { platform_validation: { … min-attachments … } }
# No state change — the post stays a draft.
POST {{baseUrl}}/api/posts/{{scheduleBadDraftId}}/schedule
Content-Type: application/json

{
  "scheduled_at": "{{futureAt}}",
  "allow_promote": true
}

### 5. Schedule a DRAFT without allow_promote (expects 400)  [protected]
# Run createDraft first. A draft isn't schedulable unless you opt into promotion.
POST {{baseUrl}}/api/posts/{{scheduleDraftId}}/schedule
Content-Type: application/json

{
  "scheduled_at": "{{futureAt}}"
}

### 6. Schedule with a past scheduled_at (expects 400)  [protected]
# Run createReadyPost first.
POST {{baseUrl}}/api/posts/{{scheduleReadyId}}/schedule
Content-Type: application/json

{
  "scheduled_at": "{{pastAt}}"
}

### 7. Schedule with missing scheduled_at (expects 400)  [protected]
POST {{baseUrl}}/api/posts/{{scheduleReadyId}}/schedule
Content-Type: application/json

{}

### 8. Schedule a non-existent post (expects 404)  [protected]
POST {{baseUrl}}/api/posts/nonexistent/schedule
Content-Type: application/json

{
  "scheduled_at": "{{futureAt}}"
}

### 9. Reschedule an already-scheduled post (expects 400)  [protected]
# After scenario 1/2/3 the post is no longer ready_for_publish, so scheduling it
# again is rejected — cancel it first (posts cancel endpoint) to reschedule.
POST {{baseUrl}}/api/posts/{{scheduleReadyId}}/schedule
Content-Type: application/json

{
  "scheduled_at": "{{futureAt}}"
}

###
# ── Multiple same-platform accounts — CON-150 ─────────────────────────────────
###
# When a platform has 2+ connected accounts, an AUTO-publish post must name one
# via social_account_id (set on the POST /api/posts body, NOT the schedule body
# below). Scheduling an auto-publish post that leaves it unset is rejected with
# 422 "account_selection_required" listing the candidate accounts. The gate only
# fires for auto-publish — a manual-publish post (Setup B) never submits through
# Zernio, so it schedules fine without an account.
#
# Prereqs: Setup A (allowlist LinkedIn) + connect TWO LinkedIn accounts
# (publishers/zernio/zernio.http), then run its "List accounts" to populate
# {{linkedinAccountId}}.

### Helper — ready LinkedIn post with NO account chosen  [protected]
# @name createReadyPostNoAccount
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{linkedinPlatformId}}",
  "platform_post_type": "article",
  "title": "Ambiguous account",
  "content": "Which LinkedIn account should this go to?",
  "status": "ready_for_publish",
  "cta_type": "none"
}

> {% client.global.set("scheduleNoAccountId", response.body.id) %}

### Helper — ready LinkedIn post targeting a specific account  [protected]
# @name createReadyPostWithAccount
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{linkedinPlatformId}}",
  "platform_post_type": "article",
  "title": "Chosen account",
  "content": "This one names its LinkedIn account.",
  "social_account_id": "{{linkedinAccountId}}",
  "status": "ready_for_publish",
  "cta_type": "none"
}

> {% client.global.set("scheduleWithAccountId", response.body.id) %}

### 10. Schedule AUTO with 2+ accounts and none chosen (expects 422)  [protected]
# Run Setup A + connect two LinkedIn accounts + createReadyPostNoAccount first.
# → 422 { error: "account_selection_required", platform: "linkedin",
#         candidates: [ { id, username, displayName }, … ] }
POST {{baseUrl}}/api/posts/{{scheduleNoAccountId}}/schedule
Content-Type: application/json

{
  "scheduled_at": "{{futureAt}}"
}

### 11. Schedule AUTO with an explicit account (expects 200 scheduled)  [protected]
# Run Setup A + createReadyPostWithAccount first.
# → 200 { status: "scheduled", auto_publish: true } — submits to that account.
POST {{baseUrl}}/api/posts/{{scheduleWithAccountId}}/schedule
Content-Type: application/json

{
  "scheduled_at": "{{futureAt}}"
}

###
# ── Schedule via the Post Assistant (SSE) — CON-78 ────────────────────────────
###
# Natural-language scheduling is an OFFER the user confirms: the schedulePost
# call is held back, not run, until the user says yes.
# Requires ANTHROPIC_API_KEY set on the server; returns 503 when disabled.
# The assistant resolves the relative time against the workspace timezone
# (settings → timezone) and the current time. Response is a Server-Sent
# Events stream (see POST /api/assistant).

### Turn 1 — ask to schedule (the assistant OFFERS, does not commit)  [protected]
# Run createReadyPost (or createDraft) first; uses {{scheduleReadyId}}.
# Expect a "proposal_created" event { id, tool: "schedulePost", summary,
# expiresAt } with the resolved absolute time, and no schedule_complete yet.
# Copy its id into {{scheduleProposalId}}.
POST {{baseUrl}}/api/assistant
Accept: text/event-stream
Content-Type: application/json

{
  "instruction": "Schedule this for tomorrow at 9am.",
  "viewContext": {"version": 1, "screen": "post", "scope": {"kind": "post", "id": "{{scheduleReadyId}}"}, "focus": {"kind": "post", "id": "{{scheduleReadyId}}"}}
}

### Turn 2a — confirm from the card (runs the stored schedule, no model call)  [protected]
# Expect schedule_started → schedule_complete { scheduledAt, status,
# autoPublish, promoted } and a "complete" whose results.post.action is
# "scheduled".
POST {{baseUrl}}/api/assistant/proposals/{{scheduleProposalId}}/confirm
Accept: text/event-stream

### Turn 2b — or confirm in chat  [protected]
# The assistant confirms the waiting offer (confirmOffer); same events as 2a.
POST {{baseUrl}}/api/assistant
Accept: text/event-stream
Content-Type: application/json

{
  "instruction": "Yes, go ahead.",
  "viewContext": {"version": 1, "screen": "post", "scope": {"kind": "post", "id": "{{scheduleReadyId}}"}, "focus": {"kind": "post", "id": "{{scheduleReadyId}}"}}
}

### Schedule a draft via the assistant — promote on confirm  [protected]
# Run createDraft first; uses {{scheduleDraftId}}. The assistant checks
# readiness and offers the schedule with allowPromote; confirming it
# promotes and schedules.
POST {{baseUrl}}/api/assistant
Accept: text/event-stream
Content-Type: application/json

{
  "instruction": "Publish this next Monday morning.",
  "viewContext": {"version": 1, "screen": "post", "scope": {"kind": "post", "id": "{{scheduleDraftId}}"}, "focus": {"kind": "post", "id": "{{scheduleDraftId}}"}}
}
