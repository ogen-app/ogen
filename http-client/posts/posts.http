@baseUrl = http://localhost:9001

# All post endpoints require authentication.
# Run "Login" from sessions/sessions.http first — the HTTP client stores and
# sends the cookie automatically on subsequent requests to the same host.
#
# Prerequisites:
#   - A campaign ID stored in {{campaignId}} (run campaigns/campaigns.http → createCampaign)
#   - The seeded LinkedIn platform ID: "linkedin"
#
# Post status state machine:
#   draft → ready_for_publish
#   ready_for_publish → scheduled | scheduled_for_manual_publishing | draft
#   scheduled → failed | published | ready_for_publish | draft | scheduled_for_manual_publishing
#   scheduled_for_manual_publishing → published | not_published | draft
#   failed → ready_for_publish
#   not_published → ready_for_publish | scheduled_for_manual_publishing
# (scheduled → scheduled_for_manual_publishing and
#  scheduled_for_manual_publishing → draft added in CON-130; the first is
#  what the convert-to-manual flow lands on — see posts/convert-to-manual.http.)

@platformId = linkedin

### List all posts  [protected]
GET {{baseUrl}}/api/posts
Accept: application/json

### List posts by campaign  [protected]
GET {{baseUrl}}/api/campaigns/{{campaignId}}/posts
Accept: application/json

### Create post — minimal (no title)  [protected]
# @name createPost
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{platformId}}",
  "platform_post_type": "article"
}

> {% client.global.set("postId", response.body.id) %}

### Create post — all fields  [protected]
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{platformId}}",
  "platform_post_type": "article",
  "title": "5 Reasons to Try Our Platform",
  "content": "Whether you're a startup or an enterprise, here's why teams love us.",
  "media_urls": ["https://cdn.example.com/hero.png"],
  "scheduled_at": "2026-05-01T09:00:00Z",
  "status": "draft",
  "cta_type": "link",
  "cta_url": "https://example.com/signup",
  "target_audience_notes": "Tech-savvy decision-makers aged 28–45",
  "used_asset_ids": []
}

> {% client.global.set("postId", response.body.id) %}

### Create post — invalid status (expects 400)  [protected]
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{platformId}}",
  "platform_post_type": "article",
  "title": "Bad Status Post",
  "status": "unknown"
}

### Create post — invalid cta_type (expects 400)  [protected]
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{platformId}}",
  "platform_post_type": "article",
  "title": "Bad CTA Post",
  "cta_type": "popup"
}

### Create post — missing required fields (expects 400)  [protected]
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "title": "Missing campaign and platform"
}

###
# ── Multiple same-platform accounts — CON-150 ─────────────────────────────────
###
# A post may name WHICH connected account it publishes to via social_account_id
# (the Zernio accountId). Omit it and the submit worker auto-selects the
# platform's single account, or fails "account_selection_required" when the
# platform has more than one. GET responses hydrate the chosen account under
# `social_account`.
#
# Get an account id first: run publishers/zernio/zernio.http → "List local
# social-account mirror …", which stores the first two LinkedIn account ids in
# {{linkedinAccountId}} / {{linkedinAccountId2}}.

### Create post — target a specific LinkedIn account  [protected]
# @name createPostForAccount
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{platformId}}",
  "platform_post_type": "article",
  "title": "Posted from a specific account",
  "content": "This goes to one chosen LinkedIn account.",
  "social_account_id": "{{linkedinAccountId}}",
  "status": "draft",
  "cta_type": "none"
}

> {% client.global.set("postId", response.body.id) %}

### Update post — switch to the second LinkedIn account  [protected]
PUT {{baseUrl}}/api/posts/{{postId}}
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{platformId}}",
  "platform_post_type": "article",
  "title": "Now posting from the second account",
  "content": "This goes to one chosen LinkedIn account.",
  "social_account_id": "{{linkedinAccountId2}}",
  "status": "draft",
  "cta_type": "none"
}

# Verify with "Get post by ID" below — the response hydrates the chosen account
# under `social_account` (id / platform / username / display_name / avatar_url).

### Get post by ID  [protected]
GET {{baseUrl}}/api/posts/{{postId}}
Accept: application/json

### Get post — non-existent ID (expects 404)  [protected]
GET {{baseUrl}}/api/posts/nonexistent
Accept: application/json

### Update post — draft → ready_for_publish  [protected]
PUT {{baseUrl}}/api/posts/{{postId}}
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{platformId}}",
  "platform_post_type": "article",
  "title": "5 Reasons to Try Our Platform — Reviewed",
  "content": "Updated body copy after editorial review.",
  "media_urls": ["https://cdn.example.com/hero-v2.png"],
  "status": "ready_for_publish",
  "cta_type": "button",
  "cta_url": "https://example.com/signup",
  "target_audience_notes": "Tech-savvy decision-makers aged 28–45",
  "used_asset_ids": []
}

### Update post — ready_for_publish → scheduled  [protected]
PUT {{baseUrl}}/api/posts/{{postId}}
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{platformId}}",
  "platform_post_type": "article",
  "title": "5 Reasons to Try Our Platform — Reviewed",
  "scheduled_at": "2026-05-02T09:00:00Z",
  "status": "scheduled",
  "cta_type": "button",
  "cta_url": "https://example.com/signup",
  "used_asset_ids": []
}

### Update post — ready_for_publish → scheduled_for_manual_publishing  [protected]
PUT {{baseUrl}}/api/posts/{{postId}}
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{platformId}}",
  "platform_post_type": "article",
  "title": "Manual Publish Post",
  "status": "scheduled_for_manual_publishing",
  "used_asset_ids": []
}

### Update post — invalid transition (draft → published, expects 400)  [protected]
PUT {{baseUrl}}/api/posts/{{postId}}
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{platformId}}",
  "platform_post_type": "article",
  "title": "Skip Ahead",
  "status": "published"
}

### Update post — non-existent ID (expects 404)  [protected]
PUT {{baseUrl}}/api/posts/nonexistent
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{platformId}}",
  "platform_post_type": "article",
  "title": "Ghost Post"
}

### Update post — invalid status (expects 400)  [protected]
PUT {{baseUrl}}/api/posts/{{postId}}
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{platformId}}",
  "platform_post_type": "article",
  "title": "Bad Status Update",
  "status": "unknown"
}

### Delete post  [protected]
DELETE {{baseUrl}}/api/posts/{{postId}}

### Delete post — non-existent ID (expects 404)  [protected]
DELETE {{baseUrl}}/api/posts/nonexistent

###
# ── Assistant ─────────────────────────────────────────────────────────────────
###

# The post assistant is the one assistant's post pack: a turn sent from the
# post's screen, with a post-scoped viewContext, works on that post in its
# thread. Response is a Server-Sent Events stream (see POST /api/assistant).

### Send instruction to post assistant  [protected]
POST {{baseUrl}}/api/assistant
Accept: text/event-stream
Content-Type: application/json

{
  "instruction": "Make the description more concise and punchy, targeting senior developers.",
  "viewContext": {"version": 1, "screen": "post", "scope": {"kind": "post", "id": "{{postId}}"}, "focus": {"kind": "post", "id": "{{postId}}"}}
}

### Send instruction — incorporate asset info  [protected]
POST {{baseUrl}}/api/assistant
Accept: text/event-stream
Content-Type: application/json

{
  "instruction": "Incorporate key facts from the attached brand guidelines asset into the description.",
  "viewContext": {"version": 1, "screen": "post", "scope": {"kind": "post", "id": "{{postId}}"}, "focus": {"kind": "post", "id": "{{postId}}"}}
}

### Post thread — its latest messages  [protected]
GET {{baseUrl}}/api/assistant/threads/post:{{postId}}/messages

###
# ── Quality assessment — CON-85 ───────────────────────────────────────────────
###

### Assess post quality  [protected]
# Scores the post across four dimensions (correctness, clarity, engagement,
# delivery) on Sonnet 4.5 (configurable) and returns a deterministic overall %.
# Takes no body — the post id in the path is the only input.
# Requires ANTHROPIC_API_KEY to be set in the server environment.
# Returns 503 when the feature is disabled (no API key).
# Returns 404 if the post does not exist.
# 400 (via an "error" event) when the post has no body / platform / type.
# Response is a Server-Sent Events stream.
# Events: "step" (per flow stage: validateInput, buildContext, evaluate,
#   validateOutput, composeScore, persist), "complete" (PostQualityResponse —
#   the four scored dimensions with rationale, weakness, span-anchored
#   suggestions, plus the backend-computed overall %), "error" (code + message).
POST {{baseUrl}}/api/posts/{{postId}}/assess
Accept: text/event-stream

### Get stored quality assessment  [protected]
# Returns the most recent persisted evaluation for the post (CON-92) without
# invoking the model. The frontend reads this to render an existing score and
# only re-runs POST /assess when the post has changed since it was assessed.
# Returns 404 if the post has never been assessed, 503 when disabled.
GET {{baseUrl}}/api/posts/{{postId}}/assessment
Accept: application/json

###
# ── Versions ──────────────────────────────────────────────────────────────────
###

### List post versions  [protected]
GET {{baseUrl}}/api/posts/{{postId}}/versions
Accept: application/json

### Create manual version snapshot  [protected]
POST {{baseUrl}}/api/posts/{{postId}}/versions
Content-Type: application/json

{
  "note": "Manual save before major rewrite"
}
