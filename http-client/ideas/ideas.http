@baseUrl = http://localhost:9001

# CON-315: the workspace Ideas backlog. All endpoints require authentication.
# Run "Login" from sessions/sessions.http first — the HTTP client stores and
# sends the cookie automatically on subsequent requests to the same host.
# Set campaignId (e.g. from campaigns/campaigns.http) for the attach flows.

### List every idea in the workspace  [protected]
GET {{baseUrl}}/api/ideas
Accept: application/json

### List ideas attached to one campaign  [protected]
GET {{baseUrl}}/api/ideas?campaign_id={{campaignId}}
Accept: application/json

### List only workspace-wide (unfiled) ideas  [protected]
GET {{baseUrl}}/api/ideas?campaign_id=none
Accept: application/json

### List an asset's analysis ideas, best fit first (unscored last)  [protected]
GET {{baseUrl}}/api/ideas?asset_id={{assetId}}&sort=fit
Accept: application/json

### Unknown sort (expects 400 invalid_filter)  [protected]
GET {{baseUrl}}/api/ideas?sort=score
Accept: application/json

### First page of the waiting pile, best fit first, with facets  [protected]
# @name ideasPage
GET {{baseUrl}}/api/ideas?pile=waiting&sort=fit&limit=50&facets=origin,source_asset,kind,campaign_id,fit,phase,author,created&tz=Europe/Kyiv
Accept: application/json

> {% client.global.set("ideasCursor", response.body.next_cursor) %}

### Next page of the same list  [protected]
GET {{baseUrl}}/api/ideas?pile=waiting&sort=fit&limit=50&cursor={{ideasCursor}}
Accept: application/json

### Analysed PDF and audio ideas that fit well, grouped by source  [protected]
GET {{baseUrl}}/api/ideas?origin=asset_analysis&kind=pdf,audio&fit=high,medium&group=source&sort=fit&limit=50
Accept: application/json

### Written ideas from the last 7 days, newest first, grouped by author  [protected]
GET {{baseUrl}}/api/ideas?source_asset=none&created=7d&tz=Europe/Kyiv&group=author&sort=created_desc&limit=50
Accept: application/json

### Text search, excluding ideas already answered no  [protected]
GET {{baseUrl}}/api/ideas?text=agents&pile_not=no&limit=50
Accept: application/json

### One campaign's ideas only (totals, piles and facets too)  [protected]
GET {{baseUrl}}/api/ideas?scope_campaign={{campaignId}}&facets=fit,origin&limit=50
Accept: application/json

### Select every waiting idea from PDFs (ids only, up to 5,000)  [protected]
GET {{baseUrl}}/api/ideas?pile=waiting&kind=pdf&ids_only=true
Accept: application/json

### Delete a selection (unknown ids come back in failed)  [protected]
POST {{baseUrl}}/api/ideas/bulk-delete
Content-Type: application/json

{
  "ids": ["{{ideaId}}", "not-an-idea"]
}

### Edit an analysed idea's title (expects 409 idea_read_only)  [protected]
PATCH {{baseUrl}}/api/ideas/{{analysedIdeaId}}
Content-Type: application/json

{
  "title": "My own words"
}

### Capture an idea (title only → workspace-wide, waiting)  [protected]
# @name captureIdea
POST {{baseUrl}}/api/ideas
Content-Type: application/json

{
  "title": "A teardown of our own onboarding",
  "note": "",
  "campaign_id": null
}

> {% client.global.set("ideaId", response.body.id) %}

### Capture an idea on a campaign  [protected]
POST {{baseUrl}}/api/ideas
Content-Type: application/json

{
  "title": "Customer quote carousel",
  "campaign_id": "{{campaignId}}"
}

### Capture — blank title (expects 400)  [protected]
POST {{baseUrl}}/api/ideas
Content-Type: application/json

{
  "title": "   "
}

### Edit the title only (note and campaign untouched)  [protected]
PATCH {{baseUrl}}/api/ideas/{{ideaId}}
Content-Type: application/json

{
  "title": "A teardown of our onboarding, week one"
}

### Clear the note  [protected]
PATCH {{baseUrl}}/api/ideas/{{ideaId}}
Content-Type: application/json

{
  "note": ""
}

### Attach to a campaign  [protected]
PATCH {{baseUrl}}/api/ideas/{{ideaId}}
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}"
}

### Detach back to workspace-wide  [protected]
PATCH {{baseUrl}}/api/ideas/{{ideaId}}
Content-Type: application/json

{
  "campaign_id": null
}

### PATCH with a verdict (expects 400 — decisions go through PUT …/verdict)  [protected]
PATCH {{baseUrl}}/api/ideas/{{ideaId}}
Content-Type: application/json

{
  "verdict": "yes"
}

### Verdict: yes  [protected]
PUT {{baseUrl}}/api/ideas/{{ideaId}}/verdict
Content-Type: application/json

{
  "verdict": "yes",
  "remind_at": null
}

### Verdict: later, back in a week  [protected]
< {%
    request.variables.set("inAWeek", new Date(Date.now() + 7 * 864e5).toISOString());
%}
PUT {{baseUrl}}/api/ideas/{{ideaId}}/verdict
Content-Type: application/json

{
  "verdict": "later",
  "remind_at": "{{inAWeek}}"
}

### Verdict: later without remind_at (expects 400)  [protected]
PUT {{baseUrl}}/api/ideas/{{ideaId}}/verdict
Content-Type: application/json

{
  "verdict": "later",
  "remind_at": null
}

### Verdict: no (archive)  [protected]
PUT {{baseUrl}}/api/ideas/{{ideaId}}/verdict
Content-Type: application/json

{
  "verdict": "no",
  "remind_at": null
}

### Undo — back to the inbox  [protected]
PUT {{baseUrl}}/api/ideas/{{ideaId}}/verdict
Content-Type: application/json

{
  "verdict": null,
  "remind_at": null
}

### Delete the idea (hard delete)  [protected]
DELETE {{baseUrl}}/api/ideas/{{ideaId}}

### Delete again (expects 404)  [protected]
DELETE {{baseUrl}}/api/ideas/{{ideaId}}
