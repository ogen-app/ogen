@baseUrl = http://localhost:9001

# Analytics for posts published with Zernio — CON-93.
# Two read-only endpoints, both served ENTIRELY from the database. A background
# worker (refresh_zernio_analytics) batch-fetches engagement analytics from
# Zernio on a schedule and upserts the post_analytics table; the request path
# NEVER calls Zernio.
#   - GET /api/posts/:id/analytics   per-post snapshot (FR4)
#   - GET /api/analytics/posts       overview across Zernio-published posts (FR5)
#
# All endpoints require authentication. Run "Login" from sessions/sessions.http
# first — the HTTP client stores and replays the cookie automatically.
#
# Prerequisites for REAL data:
#   - A post published through Zernio so it carries a publisher_post_id (posts
#     go submit → poll → published via the integration; see the auto-publish
#     schedule flow in posts/schedule.http and publishers/zernio/zernio.http).
#   - The refresh worker must have run at least once (default cadence
#     river-service's ZERNIO_ANALYTICS_REFRESH_INTERVAL, lookback ZERNIO_ANALYTICS_WINDOW_DAYS=90)
#     to populate a snapshot. Until a post is covered, the per-post endpoint
#     returns 200 { "status": "pending" } rather than 404 — so clients can poll.
#
# Set {{postId}} to a Zernio-published post id (capture it from the schedule /
# publish flow). {{campaignId}} comes from campaigns/campaigns.http.

@linkedinPlatformId = AXqWG7U2qnpt

###
# ── Per-post snapshot — GET /api/posts/:id/analytics (FR4) ────────────────────
###

### Per-post analytics — covered post → 200 snapshot  [protected]
# → 200 {
#     post_id, publisher: "zernio", publisher_post_id, sync_status,
#     metrics_last_updated, last_refreshed_at,
#     analytics: { impressions, reach, likes, comments, shares, saves, clicks,
#                  views, engagement_rate },
#     platform_analytics: [ { platform, status, platform_post_id, account_id,
#                  account_username, platform_post_url, sync_status,
#                  error_message, analytics{...} } ]
#   }
# Per-platform rows that lack analytics scope (Zernio 412 / reauthorizeUrl)
# carry their own sync_status/error_message without failing the whole response;
# platforms that do report still return metrics.
GET {{baseUrl}}/api/posts/{{postId}}/analytics
Accept: application/json

### Per-post analytics — published but not yet refreshed → 200 pending  [protected]
# Same endpoint; before the refresh worker has covered the post.
# → 200 { "status": "pending", "post_id": "..." }
GET {{baseUrl}}/api/posts/{{postId}}/analytics
Accept: application/json

### Helper — create a DRAFT (never published via a publisher)  [protected]
# @name createDraftForAnalytics
# Used to demonstrate the 409 path below — a draft has no publisher_post_id.
POST {{baseUrl}}/api/posts
Content-Type: application/json

{
  "campaign_id": "{{campaignId}}",
  "platform_id": "{{linkedinPlatformId}}",
  "platform_post_type": "article",
  "title": "Never published — no analytics",
  "content": "Draft body; this post was never published through Zernio.",
  "status": "draft",
  "cta_type": "none"
}

> {% client.global.set("draftAnalyticsId", response.body.id) %}

### Per-post analytics — post not published via a publisher → 409  [protected]
# Run createDraftForAnalytics first.
# → 409 { "code": "not_published_via_publisher", "error": "..." }
GET {{baseUrl}}/api/posts/{{draftAnalyticsId}}/analytics
Accept: application/json

### Per-post analytics — unknown post → 404  [protected]
GET {{baseUrl}}/api/posts/nonexistent/analytics
Accept: application/json

###
# ── Overview — GET /api/analytics/posts (FR5) ─────────────────────────────────
###
# Restricted to Zernio-published posts that have a snapshot. Returns items +
# pagination + an overview block of summed totals and average engagement_rate.
#   sort_by ∈ engagement | impressions | reach | likes | comments | shares |
#            saves | clicks | views | published_at        (default engagement)
#   order   ∈ asc | desc                                   (default desc)
#   page    default 1 ; limit default 50, clamped to max 100
#   platform (optional) filters by platform name, e.g. "LinkedIn"

### Overview — defaults (engagement desc, page 1, limit 50)  [protected]
# → 200 {
#     items: [ { post_id, title, publisher, platform, published_at,
#                sync_status, analytics{...} } ],
#     pagination: { page, limit, total, pages },
#     overview: { post_count, impressions, reach, likes, comments, shares,
#                 saves, clicks, views, engagement_rate_avg }
#   }
GET {{baseUrl}}/api/analytics/posts
Accept: application/json

### Overview — sort by impressions, paged  [protected]
GET {{baseUrl}}/api/analytics/posts?sort_by=impressions&order=desc&page=1&limit=20
Accept: application/json

### Overview — sort by reach ascending  [protected]
GET {{baseUrl}}/api/analytics/posts?sort_by=reach&order=asc
Accept: application/json

### Overview — sort by published_at  [protected]
GET {{baseUrl}}/api/analytics/posts?sort_by=published_at&order=desc
Accept: application/json

### Overview — filter by platform name (matches platforms.name)  [protected]
GET {{baseUrl}}/api/analytics/posts?platform=LinkedIn
Accept: application/json

### Overview — limit above max is clamped to 100  [protected]
GET {{baseUrl}}/api/analytics/posts?limit=500
Accept: application/json

### Overview — invalid sort_by → 400  [protected]
GET {{baseUrl}}/api/analytics/posts?sort_by=bogus
Accept: application/json

### Overview — invalid order → 400  [protected]
GET {{baseUrl}}/api/analytics/posts?order=sideways
Accept: application/json

###
# ═════════════════════════════════════════════════════════════════════════════
# CON-153 — Zernio analytics suite: insight aggregates + follower history
# ═════════════════════════════════════════════════════════════════════════════
#
# Four NEW read surfaces (the on-demand external-post verify lives in
# posts/verify-external.http):
#   - GET /api/analytics/best-times          day×hour engagement grid
#   - GET /api/analytics/content-decay       engagement-accrual buckets
#   - GET /api/analytics/posting-frequency   cadence↔engagement per platform
#   - GET /api/analytics/followers           follower history + growth per account
#
# best-times / content-decay / posting-frequency are LIVE read-through proxies:
# the request path calls Zernio, scoped to the tenant's Zernio profile. followers
# is served ENTIRELY from local snapshots — a daily refresh_zernio_followers job
# (river-service's ZERNIO_FOLLOWER_REFRESH_INTERVAL, 24h) populates follower_stats_snapshots.
#
# Graceful add-on gating (the three proxies + followers upstream need Zernio's
# Analytics add-on):
#   - success            → 200 { "available": true,  "data": { ... } }
#   - add-on missing     → 200 { "available": false, "reason": "addon_required",  "data": null }
#   - Zernio not set up  → 200 { "available": false, "reason": "not_configured",  "data": null }
# These are 200s, NOT errors, so the UI renders an upsell/empty state directly.
#
# Shared query params for the three proxies: platform (Zernio slug, e.g.
# "instagram"), account_id, source ∈ all|late|external (default all).
#
# Set {{accountId}} to a connected Zernio social-account id (capture it from
# publishers/zernio/zernio.http → list accounts). Leave empty to span all.

@accountId =

###
# ── Best times to post — GET /api/analytics/best-times ────────────────────────
###

### Best times — all platforms/accounts  [protected]
# → 200 { available: true, data: { slots: [ { day_of_week (0=Sun, UTC),
#         hour (0-23, UTC), avg_engagement, post_count } ] } }
GET {{baseUrl}}/api/analytics/best-times
Accept: application/json

### Best times — filter by platform, account, source  [protected]
GET {{baseUrl}}/api/analytics/best-times?platform=instagram&account_id={{accountId}}&source=all
Accept: application/json

### Best times — invalid source → 400  [protected]
GET {{baseUrl}}/api/analytics/best-times?source=bogus
Accept: application/json

###
# ── Content performance decay — GET /api/analytics/content-decay ──────────────
###

### Content decay — all platforms  [protected]
# → 200 { available: true, data: { buckets: [ { bucket_order, bucket_label
#         (e.g. "0-6h"), avg_pct_of_final, post_count } ] } }
GET {{baseUrl}}/api/analytics/content-decay
Accept: application/json

### Content decay — one platform  [protected]
GET {{baseUrl}}/api/analytics/content-decay?platform=instagram
Accept: application/json

###
# ── Posting frequency vs engagement — GET /api/analytics/posting-frequency ────
###

### Posting frequency — all platforms  [protected]
# → 200 { available: true, data: { frequency: [ { platform, posts_per_week,
#         avg_engagement_rate, avg_engagement, weeks_count } ] } }
GET {{baseUrl}}/api/analytics/posting-frequency
Accept: application/json

### Posting frequency — one platform  [protected]
GET {{baseUrl}}/api/analytics/posting-frequency?platform=instagram
Accept: application/json

###
# ── Follower stats — GET /api/analytics/followers ─────────────────────────────
###
# Served from local daily snapshots (no publisher call on the request path).
# When analytics storage is disabled (ANALYTICS_DSN unset) → 503.
#   account_id  (optional) restrict to one account
#   from / to   (optional) YYYY-MM-DD window on the point date
#   granularity ∈ daily | weekly | monthly (default daily; weekly/monthly keep
#               the last point per ISO-week / calendar month)

### Follower stats — summary + daily series, all accounts  [protected]
# → 200 { available: true, data: {
#     accounts: [ { account_id, platform, username, current_followers, growth,
#                   growth_percentage, data_points } ],
#     series:   { "<account_id>": [ { date, followers } ] },
#     granularity } }
GET {{baseUrl}}/api/analytics/followers
Accept: application/json

### Follower stats — one account, windowed, weekly downsample  [protected]
GET {{baseUrl}}/api/analytics/followers?account_id={{accountId}}&from=2026-07-01&to=2026-07-31&granularity=weekly
Accept: application/json

### Follower stats — monthly rollup  [protected]
GET {{baseUrl}}/api/analytics/followers?granularity=monthly
Accept: application/json

### Follower stats — invalid granularity → 400  [protected]
GET {{baseUrl}}/api/analytics/followers?granularity=hourly
Accept: application/json

### Follower stats — malformed date → 400  [protected]
GET {{baseUrl}}/api/analytics/followers?from=07-2026
Accept: application/json

###
# ── Cumulative overview — GET /api/analytics/overview (CON-237) ───────────────
# Five KPI cards + per-metric series (current/previous/band) + no-AI insights,
# in one tenant-scoped call. Latest-per-post from post_analytics_current; posts
# published from the main-DB posts table. Baseline band is "insufficient_history"
# until enough prior windows accrue.
###

# Default window (last 28 days).
GET {{baseUrl}}/api/analytics/overview
Accept: application/json

###
# Relative window shorthand.
GET {{baseUrl}}/api/analytics/overview?window=7d
Accept: application/json

###
# Explicit inclusive date range (overrides window).
GET {{baseUrl}}/api/analytics/overview?from=2026-07-22&to=2026-08-19
Accept: application/json

###
# Longer window auto-buckets weekly; force with &granularity=week.
GET {{baseUrl}}/api/analytics/overview?window=120d
Accept: application/json

###
# Invalid range → 400 invalid_range.
GET {{baseUrl}}/api/analytics/overview?from=2026-08-19&to=2026-07-22
Accept: application/json

###
# ── Performers & outliers — GET /api/analytics/performers (CON-238) ───────────
# Best/Worst posts for the window, each scored against the account's typical
# post for its platform and age (against_typical multiplier), + no-AI insights.
# Multiplier is null (baseline "insufficient_history") until a platform has
# enough history; those posts rank by the raw metric.
###

# Default: ranked by "against your typical", last 28 days, 5 per list.
GET {{baseUrl}}/api/analytics/performers
Accept: application/json

###
# Re-rank by raw reach.
GET {{baseUrl}}/api/analytics/performers?by=reach
Accept: application/json

###
# By engagement rate, longer window, bigger lists.
GET {{baseUrl}}/api/analytics/performers?by=engagement_rate&window=90d&limit=10
Accept: application/json

###
# Filter to one platform, explicit date range.
GET {{baseUrl}}/api/analytics/performers?platform=linkedin&from=2026-07-22&to=2026-08-19
Accept: application/json

###
# Invalid sort → 400 invalid_sort.
GET {{baseUrl}}/api/analytics/performers?by=nonsense
Accept: application/json

###
# ── Learnings (all-time) — GET /api/analytics/learnings (CON-239) ─────────────
# "What we've learned": a day×hour heatmap, a post-lifespan curve (t50/t75/t95),
# and structural what-works/what's-fading patterns. All-time by default and
# decoupled from the dashboard window; each section degrades independently to
# {insufficient_history:true} until there's enough data.
###

# All-time, reach-based (default).
GET {{baseUrl}}/api/analytics/learnings
Accept: application/json

###
# Optional baseline lower bound + saves as the primary metric.
GET {{baseUrl}}/api/analytics/learnings?since=2026-01-01&metric=saves
Accept: application/json

###
# Wider fading comparison window.
GET {{baseUrl}}/api/analytics/learnings?trend_window=6mo
Accept: application/json

###
# Invalid metric → 400 invalid_param.
GET {{baseUrl}}/api/analytics/learnings?metric=nonsense
Accept: application/json

###
# ── Per-post statistics — GET /api/analytics/posts/:post_id (CON-250) ──────────
# The single-post drill-down: the post header, six metric cards (reach,
# impressions, interactions, engagement_rate, saves, clicks) — each with an
# age-adjusted against_typical multiplier + a per-metric usual-range band
# (above/typical/below from p25/p50/p75-at-age) — the per-metric running-total
# series since publishing, and a deterministic narrative wired to the CON-239
# lifespan (t50 half-life + t95 "still counting"). No window params: the series
# spans [published_at, now]. Distinct from GET /api/posts/:id/analytics (CON-93).
#
# States:
#   - ready              → data.overview.state = "ready", six cards + series
#   - platform silent    → data.overview.state = "awaiting_platform" (header only,
#                          empty cards/series) — the post is out but the refresh
#                          hasn't recorded a row yet ("nothing back yet")
#   - thin baseline      → per-card baseline:"insufficient_history" (value only)
#   - analytics disabled → 200 { available:false, reason:"not_configured" }
#
# Set {{postId}} to a Zernio-published post id.
###

### Per-post statistics — ready post  [protected]
# → 200 { available:true, data: {
#     updated_at, still_counting,
#     post:    { post_id, publisher_post_id, title, media_format, platform,
#                account{ id, username, display_name, avatar_url },
#                published_at, age_hours, campaign{ id, name }, open_url },
#     overview:{ state:"ready", window_label:"first 4 hours",
#                cards:[ { metric, value, against_typical, delta_pct, band,
#                          baseline } ],
#                narrative:[ { id, severity, text } ] },
#     series:  { reach:[ { age_hours, value } ], impressions:[...], ... } } }
GET {{baseUrl}}/api/analytics/posts/{{postId}}
Accept: application/json

### Per-post statistics — post not published via a publisher → 409  [protected]
# Run createDraftForAnalytics (above) first.
# → 409 { "code": "not_published_via_publisher", "error": "..." }
GET {{baseUrl}}/api/analytics/posts/{{draftAnalyticsId}}
Accept: application/json

### Per-post statistics — unknown / cross-tenant post → 404  [protected]
GET {{baseUrl}}/api/analytics/posts/nonexistent
Accept: application/json
