@baseUrl = http://localhost:9001

# All campaign endpoints require authentication.
# Run "Login" from sessions/sessions.http first — the HTTP client stores and
# sends the cookie automatically on subsequent requests to the same host.
#
# Seeded campaign type IDs (see campaign_types/campaign_types.http for full list):
#   Uk = Awareness   gb = Engagement   Ef = Conversion   Vq = Retention

### List all campaigns  [protected]
GET {{baseUrl}}/api/campaigns
Accept: application/json

### Campaigns list summaries — batched post projections  [protected]  (CON-152)
# One request for the whole Campaigns list instead of one GET /:id/posts per
# card (fixes the CON-127 N+1). Returns a slim per-post projection grouped by
# campaign — only the fields the client's readiness rules read (status,
# scheduled_at / published_at, platform_id, platform_post_type,
# campaign_type_phase_id, media_urls, created_at / updated_at). No title,
# content, or hydrated relations. Campaigns with no posts are omitted.
# Synchronous JSON (not SSE). 503 when the summaries service is unwired.
GET {{baseUrl}}/api/campaigns/summaries
Accept: application/json

### Create campaign — minimal  [protected]
# @name createCampaign
POST {{baseUrl}}/api/campaigns
Content-Type: application/json

{
  "name": "Summer Awareness Push",
  "campaign_type_id": "Uk"
}

> {% client.global.set("campaignId", response.body.id) %}

### Create campaign — all fields  [protected]
POST {{baseUrl}}/api/campaigns
Content-Type: application/json

{
    "name": "Rust programming language in modern financial applications",
    "campaign_type_id": "Uk",
    "description": "Educate financial technology professionals and engineering leaders on the advantages of Rust for building high-performance, memory-safe financial systems — from trading engines to risk modeling pipelines.",
    "target_persona": "Senior software engineers, tech leads, and CTOs at fintech companies and financial institutions, aged 28–45, evaluating systems-level languages for latency-sensitive and safety-critical workloads.",
    "key_messages": "Rust delivers C++-level performance with compile-time memory safety — no garbage collector pauses, no data races, no 3 AM crashes in production. The language the finance industry didn't know it was waiting for.",
    "tone_guidelines": "Technically credible yet accessible. Confident without being preachy. Speak peer-to-peer with engineers — show, don't sell. Use concrete benchmarks and real-world case studies over abstract claims.",
    "status": "scheduled",
    "use_assets": true,
    "asset_ids": [],
    "target_platforms": [
        {"id": "AXqWG7U2qnpt", "post_types": ["text-post", "article", "carousel"]},
        {"id": "zBU1zqVICGfk", "post_types": ["text-post", "image-post", "video"]},
        {"id": "pQ4yxT3SuE57", "post_types": ["text-post"]}
    ],
    "start_date": "2026-10-01T00:00:00Z",
    "end_date": "2026-12-31T23:59:59Z",
    "estimated_post_count": 30,
    "budget": 5000.00,
    "currency": "USD",
    "language": "en",
    "tag_ids": [],
    "publishing_time": "09:00",
    "timezone": "Asia/Nicosia",
    "publishing_days": ["mon", "wed", "fri"],
    "spread_minutes": 15
}

> {% client.global.set("campaignId", response.body.id) %}

